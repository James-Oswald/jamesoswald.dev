.details-shortcode {
  margin: 2rem 0;
  overflow: hidden;
  border: 1px solid #cccccc;
  border-radius: 0.6rem;
  background-color: #fafafa; }
  .details-shortcode summary {
    padding: 1rem 1.4rem;
    color: inherit;
    font-weight: 600;
    cursor: pointer;
    user-select: none; }
  .details-shortcode[open] summary {
    border-bottom: 1px solid #cccccc; }
  .details-shortcode__content {
    padding: 0.2rem 1.4rem 1.4rem; }
  .details-shortcode__content > :last-child {
    margin-bottom: 0; }

body.colorscheme-dark .details-shortcode {
  border-color: #4f4f4f;
  background-color: #2b2b2b; }
  body.colorscheme-dark .details-shortcode[open] summary {
    border-bottom-color: #4f4f4f; }

@media (prefers-color-scheme: dark) {
  body.colorscheme-auto .details-shortcode {
    border-color: #4f4f4f;
    background-color: #2b2b2b; }
    body.colorscheme-auto .details-shortcode[open] summary {
      border-bottom-color: #4f4f4f; } }

